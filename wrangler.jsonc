{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adaptive-lifting",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
