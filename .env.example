# Local Vite development uses same-origin /api paths.
# Point this at the Supabase project origin; there is no Python fallback.
API_EDGE_TARGET=https://<project-ref>.supabase.co

# Public browser values only. Never put private keys or provider secrets in VITE_*.
VITE_GOOGLE_CLIENT_ID=
VITE_OFFLINE_AUTH_PUBLIC_KEY=
