# Local Vite development uses same-origin /api paths.
# Point this at the Supabase project origin; there is no Python fallback.
API_EDGE_TARGET=https://<project-ref>.supabase.co

# Server secrets are not set here. CLIENT_IP_SIGNING_KEY lives only in the Worker
# (wrangler secret put) and the Edge Functions (supabase secrets set), same value.

# Public browser values only. Never put private keys or provider secrets in VITE_*.
VITE_GOOGLE_CLIENT_ID=
VITE_OFFLINE_AUTH_PUBLIC_KEY=
# Integrations page (Telegram, Sheets). Unset = on in dev, off in production builds.
VITE_INTEGRATIONS_ENABLED=
