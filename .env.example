# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- External Integrations Configuration ---

# TELEGRAM_BOT_TOKEN: Bot token used for outbound Telegram API calls.
TELEGRAM_BOT_TOKEN="mock_bot_token"

# TELEGRAM_WEBHOOK_SECRET: Secret token used to verify inbound Telegram webhook headers.
TELEGRAM_WEBHOOK_SECRET="mock_webhook_secret"

# GOOGLE_OAUTH_CLIENT_ID: Google OAuth 2.0 client identifier for Sheets exports.
GOOGLE_OAUTH_CLIENT_ID="mock_client_id"

# GOOGLE_OAUTH_CLIENT_SECRET: Google OAuth 2.0 client secret.
GOOGLE_OAUTH_CLIENT_SECRET="mock_client_secret"

# --- Security & Persistence Configuration ---

# INTEGRATION_ENCRYPTION_KEY: Secret key used to encrypt Google OAuth tokens at rest in SQLite.
INTEGRATION_ENCRYPTION_KEY="dev-only-change-me"

# JWT_SECRET_CURRENT: Required. Used to sign session JWTs. Never hardcode in source.
JWT_SECRET_CURRENT="dev-only-unspecified-secret"

# JWT_SECRET_PREVIOUS: Optional previous signing key retained during rotation.
# JWT_SECRET_PREVIOUS=""

# DATABASE_URL: Database connection string (defaults to local SQLite database).
DATABASE_URL="sqlite:///backend/database.sqlite"

# CORS_ALLOWED_ORIGINS: Required comma-separated frontend origins. Wildcard * is not allowed.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# COOKIE_SECURE: Set to true in production to force HTTPS transmission of HttpOnly session cookies.
COOKIE_SECURE="false"
