# Frontend/Caddy host configuration only. Application secrets belong in the
# production Supabase project, never in this file or the frontend image.
APP_DOMAIN=lift.example.com
SUPABASE_EDGE_HOST=your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# These are public frontend build values. Leave disabled providers blank.
VITE_GOOGLE_CLIENT_ID=
VITE_OFFLINE_AUTH_PUBLIC_KEY=
