# Copy to .env.production, set strict file permissions, and replace every placeholder.
APP_DOMAIN=lift.example.com
APP_URL=https://lift.example.com
APP_ENV=production
DATABASE_URL=postgresql+psycopg://user:password@persistent-postgres.example.com:5432/adaptive_lifting
CORS_ALLOWED_ORIGINS=https://lift.example.com
COOKIE_SECURE=true
PORT=8000
JWT_SECRET_CURRENT=replace-with-a-long-random-secret
JWT_SECRET_PREVIOUS=
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional integrations. Leave blank when unused.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
# This public browser ID must match GOOGLE_CLIENT_ID when Google login is enabled.
VITE_GOOGLE_CLIENT_ID=

# Enable only after configuring Stripe product prices and the webhook endpoint.
# Production accepts live-mode events only; never use test credentials here.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXPECT_LIVEMODE=true
STRIPE_PRICE_COACH_STARTER=
STRIPE_PRICE_COACH_PRO=
STRIPE_PRICE_COACH_UNLIMITED=
VOUCHER_CODE_SECRET=
SUBSCRIPTION_PAST_DUE_GRACE_DAYS=3

# Frontend builds use same-origin /api requests by default. Only set this for
# an intentionally separate API origin; credentialed CORS and cookie settings
# must then be configured on the API.
# VITE_BACKEND_URL=https://api.example.com
