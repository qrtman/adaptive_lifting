# Edge Function runtime configuration only. Put secret values in the Supabase
# project's secret manager; this file intentionally contains no credentials.
# Required secret names to configure later in that secret manager:
# DATABASE_URL (restricted al_edge_catalog_runtime login)
# JWT_SECRET_CURRENT (unique production key, at least 32 characters)
# REALTIME_JWT_PRIVATE_JWK (private P-256 key; API process requires it at startup)
# OFFLINE_AUTH_PRIVATE_KEY (private offline authorization signing key)
# Optional key overlap for approved session continuity: JWT_SECRET_PREVIOUS
APP_ENV=production
APP_URL=https://app.goatedmethod.me
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://app.goatedmethod.me

# Keep optional services disabled until each provider has separate approval
# and a real APP_URL-dependent E2E test.
STRIPE_BILLING_ENABLED=false
STRIPE_EXPECT_LIVEMODE=false
VOUCHER_BILLING_ENABLED=false
EMAIL_VERIFICATION_NEW_ACCOUNTS=true
EMAIL_VERIFICATION_ENFORCE_LEGACY=false
