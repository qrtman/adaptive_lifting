{
	admin off
}

:8080 {
	respond /healthz "ok" 200
}

{$APP_DOMAIN} {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy api:{$API_PORT:8000} {
			# Replace client-supplied forwarding chains before Uvicorn trusts them.
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
