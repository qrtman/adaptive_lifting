{
	admin off
}

:8080 {
	respond /healthz "ok" 200
}

{$APP_DOMAIN} {
	encode zstd gzip
	header Referrer-Policy "no-referrer"
	@verification path /verify-email
	header @verification Cache-Control "no-store"

	@api path /api /api/*
	handle @api {
		rewrite * /functions/v1{uri}
		reverse_proxy https://{$SUPABASE_EDGE_HOST} {
			header_up Host {upstream_hostport}
			header_up apikey {$SUPABASE_PUBLISHABLE_KEY}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
