# Public template only. Inject real values from the staging secret manager into
# an ignored, access-restricted .env.staging on a SEPARATE host from production.
DEPLOY_APP_ENV=staging
DEPLOY_ENV_FILE=.env.staging
APP_ENV=staging
APP_DOMAIN=staging.example.com
APP_URL=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
COOKIE_SECURE=true
PORT=8000
# Separate persistent PostgreSQL database; use the provider's TLS requirements.
DATABASE_URL=postgresql+psycopg://replace-user:replace-password@staging-postgres.example.com:5432/adaptive_lifting_staging
JWT_SECRET_CURRENT=
JWT_SECRET_PREVIOUS=
INTEGRATION_ENCRYPTION_KEY=
EMAIL_VERIFICATION_NEW_ACCOUNTS=true
EMAIL_VERIFICATION_ENFORCE_LEGACY=false
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Adaptive Lifting Staging <verify@staging-mail.example.com>"
EMAIL_PAYLOAD_ENCRYPTION_KEY=
# Stable P-256 private PEM (literal \n escapes); matching public SPKI DER base64.
OFFLINE_AUTH_PRIVATE_KEY=
VITE_OFFLINE_AUTH_PUBLIC_KEY=
# Separate staging Google web client; browser/server login IDs must match.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Optional Sheets OAuth client, with staging callback registered at Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Separate staging bot only. Never copy production tokens or change its webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Billing stays disabled unless separately validating staging test-mode billing.
STRIPE_BILLING_ENABLED=false
STRIPE_EXPECT_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_COACH_STARTER=
STRIPE_PRICE_COACH_PRO=
STRIPE_PRICE_COACH_UNLIMITED=
VOUCHER_BILLING_ENABLED=false
VOUCHER_CODE_SECRET=
SUBSCRIPTION_PAST_DUE_GRACE_DAYS=3
